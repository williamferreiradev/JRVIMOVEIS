# Supabase public connection (safe for the browser)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-publica

# Server only. Required by /usuarios to list and create Supabase Auth users.
# Configure this value in the hosting provider and never expose it as NUXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sua-chave-secreta-do-supabase
